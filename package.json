{
  "name": "jiazhouchen-portfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/generate-route-html.mjs && node scripts/verify-build.mjs",
